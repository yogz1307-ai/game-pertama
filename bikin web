<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>YOGZZ | XL PPLG</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; scroll-behavior: smooth; }
        body {
            background: #05010f;
            color: #fff;
            font-family: 'Segoe UI', sans-serif;
            overflow-x: hidden;
        }

        /* LOADING SCREEN */
        #loading {
            position: fixed; width: 100%; height: 100%;
            background: #05010f; z-index: 9999;
            display: flex; justify-content: center; align-items: center;
        }
       .loader {
            width: 50px; height: 50px;
            border: 3px solid rgba(0,255,255,0.3);
            border-top: 3px solid #00ffff;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }
        @keyframes spin { 0% {transform: rotate(0deg)} 100% {transform: rotate(360deg)} }

        /* NAVBAR */
        nav {
            position: fixed; top: 0; width: 100%;
            background: rgba(5,1,15,0.8); backdrop-filter: blur(10px);
            padding: 20px; z-index: 1000;
            border-bottom: 1px solid rgba(0,255,255,0.2);
        }
        nav a {
            color: #00ffff; text-decoration: none; margin: 0 20px;
            font-weight: bold; transition: 0.3s;
        }
        nav a:hover { text-shadow: 0 0 10px #00ffff; }

        /* HERO SECTION */
       .hero {
            height: 100vh; display: flex; justify-content: center; align-items: center;
            flex-direction: column; position: relative;
        }
       .nama {
            font-size: 6em; font-weight: 900;
            background: linear-gradient(90deg, #00ffff, #ff00ff, #00ffff);
            background-size: 200%; -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: shine 3s linear infinite;
        }
        @keyframes shine { 0% {background-position: 0%} 100% {background-position: 200%} }
       .kelas {
            font-size: 1.8em; color: #00ffff; letter-spacing: 5px;
            margin: 10px 0 30px;
        }
       .btn {
            padding: 15px 40px; border: 2px solid #00ffff;
            background: transparent; color: #00ffff;
            border-radius: 50px; font-size: 1.1em; cursor: pointer;
            transition: 0.3s; margin: 10px;
        }
       .btn:hover {
            background: #00ffff; color: #05010f;
            box-shadow: 0 0 30px #00ffff; transform: scale(1.1);
        }

        /* SECTION */
        section { padding: 100px 20px; max-width: 1200px; margin: 0 auto; }
        h2 {
            font-size: 3em; text-align: center; margin-bottom: 50px;
            color: #00ffff;
        }
       .card {
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(0,255,255,0.2);
            border-radius: 20px; padding: 30px;
            backdrop-filter: blur(15px);
            transition: 0.4s; margin: 20px 0;
        }
       .card:hover {
            transform: translateY(-15px);
            box-shadow: 0 15px 50px rgba(0,255,255,0.4);
            border-color: #00ffff;
        }

        /* SKILL */
       .skill-box { display: flex; flex-wrap: wrap; justify-content: center; gap: 15px; }
       .skill {
            padding: 10px 25px; border: 1px solid #ff00ff;
            border-radius: 30px; background: rgba(255,0,255,0.1);
        }

        /* GALERI */
       .galeri { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; }
       .galeri-item {
            height: 200px; background: linear-gradient(45deg, #ff00ff, #00ffff);
            border-radius: 15px; display: flex; justify-content: center; align-items: center;
            font-size: 2em; cursor: pointer; transition: 0.3s;
        }
       .galeri-item:hover { transform: scale(1.05) rotate(2deg); }

        /* FORM */
        input, textarea {
            width: 100%; padding: 15px; margin: 10px 0;
            background: rgba(255,255,255,0.05); border: 1px solid #00ffff;
            border-radius: 10px; color: #fff; font-size: 1em;
        }

        #particles { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; }
    </style>
</head>
<body>
    <div id="loading"><div class="loader"></div></div>
    <canvas id="particles"></canvas>

    <nav>
        <a href="#home">HOME</a>
        <a href="#tentang">TENTANG</a>
        <a href="#skill">SKILL</a>
        <a href="#galeri">GALERI</a>
        <a href="#kontak">KONTAK</a>
    </nav>

    <section class="hero" id="home">
        <h1 class="nama">YOGZZ</h1>
        <p class="kelas">KELAS XL - PPLG</p>
        <p>Web Developer | Designer | Content Creator</p>
        <div>
            <button class="btn" id="btnMulai">Jelajahi</button>
            <button class="btn" id="btnMusik">🎵 Musik</button>
        </div>
    </section>

    <section id="tentang">
        <h2>TENTANG SAYA</h2>
        <div class="card">
            <h3>Halo! Saya YOGZZ</h3>
            <p>Siswa kelas XL PPLG yang suka banget sama duia coding. 
            Dari bikin website, desain, sampe ngoding. Visi saya: jadi developer kece dan keren yang karyanya dipake banyak orang 💻</p>
        </div>
    </section>

    <section id="skill">
        <h2>SKILL SAYA</h2>
        <div class="skill-box">
            <div class="skill">HTML5</div>
            <div class="skill">CSS3</div>
            <div class="skill">JavaScript</div>
            <div class="skill">jQuery</div>
            <div class="skill">Python</div>
            <div class="skill">Figma</div>
            <div class="skill">Git</div>
        </div>
    </section>

    <section id="galeri">
        <h2>GALERI PROJECT</h2>
        <div class="galeri">
            <div class="galeri-item">PROJECT 1</div>
            <div class="galeri-item">PROJECT 2</div>
            <div class="galeri-item">PROJECT 3</div>
        </div>
    </section>

    <section id="kontak">
        <h2>KONTAK SAYA</h2>
        <div class="card">
            <input type="text" id="nama" placeholder="Nama Kamu">
            <input type="email" id="email" placeholder="Email Kamu">
            <textarea id="pesan" rows="5" placeholder="Pesan untuk YOGZZ"></textarea>
            <button class="btn" id="btnKirim">KIRIM PESAN</button>
        </div>
    </section>

    <audio id="musik" loop>
        <source src="https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3" type="audio/mpeg">
    </audio>

    <script>
        // Hilangin loading
        $(window).on('load', function(){
            $("#loading").fadeOut(1000);
        });

        // Partikel
        const canvas = document.getElementById('particles');
        const ctx = canvas.getContext('2d');
        canvas.width = window.innerWidth; canvas.height = window.innerHeight;
        let particles = [];
        for(let i=0; i<100; i++){
            particles.push({x: Math.random()*canvas.width, y: Math.random()*canvas.height, 
            size: Math.random()*2, speedX: Math.random()*1-0.5, speedY: Math.random()*1-0.5});
        }
        function animate(){
            ctx.clearRect(0,0,canvas.width,canvas.height);
            ctx.fillStyle = '#00ffff';
            particles.forEach(p => {
                p.x += p.speedX; p.y += p.speedY;
                if(p.x<0||p.x>canvas.width) p.speedX*=-1;
                if(p.y<0||p.y>canvas.height) p.speedY*=-1;
                ctx.beginPath(); ctx.arc(p.x,p.y,p.size,0,Math.PI*2); ctx.fill();
            });
            requestAnimationFrame(animate);
        }
        animate();

        // jQuery Events
        $(document).ready(function(){
            $("#btnMulai").click(() => $('html,body').animate({scrollTop: $("#tentang").offset().top}, 1000));
            
            let musikJalan = false;
            $("#btnMusik").click(function(){
                if(!musikJalan){ $("#musik")[0].play(); $(this).text("⏸️ Stop Musik"); musikJalan=true; }
                else { $("#musik")[0].pause(); $(this).text("🎵 Musik"); musikJalan=false; }
            });

            $("#btnKirim").click(function(){
                alert("Makasih " + $("#nama").val() + "! Pesan kamu udah masuk ke YOGZZ 🔥");
                $("input, textarea").val("");
            });

            $(".galeri-item").click(function(){
                alert("Ini project keren dari YOGZZ!");
            });
        });
    </script>
</body>
</html>
